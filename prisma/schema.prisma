generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PastorRole {
  id          String   @id @default(uuid())
  churchName  String
  location    String
  roleType    String
  description String
  contact     String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}
